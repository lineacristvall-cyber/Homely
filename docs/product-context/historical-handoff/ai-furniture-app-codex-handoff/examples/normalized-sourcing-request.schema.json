{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NormalizedSourcingRequest",
  "type": "object",
  "required": [
    "itemType",
    "hardConstraints",
    "softPreferences",
    "exclusions"
  ],
  "properties": {
    "itemType": {
      "type": "string"
    },
    "quantity": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "hardConstraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "value"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "value": {},
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "basis": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": true
      }
    },
    "softPreferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
